<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WidgetTea</AssemblyName>
    <RootNamespace>WidgetTea</RootNamespace>
    <ApplicationIcon>Assets\WidgetTea.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003 will die DPI-Angabe über die WinForms-API statt im Manifest. Die App ist aber WPF (WinForms nur für das
         Tray-Symbol), und WPF richtet sich nach dem Manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <Version>1.1.5</Version>
    <Product>WidgetTea</Product>
    <!-- Erscheint als „Dateibeschreibung“ in den Eigenschaften der EXE und im Task-Manager. -->
    <AssemblyTitle>WidgetTea – Gitea-Contributions auf dem Desktop</AssemblyTitle>
    <Authors>Tim Heyne</Authors>
    <Company>Celestial0579</Company>
    <Copyright>Copyright © 2026 Tim Heyne – MIT-Lizenz</Copyright>

    <!-- GitHub- oder Gitea-Repository, dessen Releases der Updater abfragt (leer = Updater aus). -->
    <UpdateRepository>https://github.com/Celestial0579/WidgetTea</UpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
    <EmbeddedResource Include="Assets\WidgetTea.ico" LogicalName="WidgetTea.ico" />
  </ItemGroup>

  <!-- Diese Projektdatei liegt im Wurzelverzeichnis und erfasst sonst alles darunter – auch das Testprojekt. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="WidgetTea.Tests" />
  </ItemGroup>

</Project>
