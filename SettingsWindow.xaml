<Window x:Class="WidgetTea.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WidgetTea – Einstellungen" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#1F2023" Foreground="#D4D4D4"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D4"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8F98"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2E31"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#44474D"/>
            <Setter Property="CaretBrush" Value="#E6E6E6"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2E31"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#44474D"/>
            <Setter Property="CaretBrush" Value="#E6E6E6"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,10,20,18">
        <TextBlock Style="{StaticResource Label}" Text="Gitea-Adresse"/>
        <TextBox x:Name="BaseUrlBox"/>
        <TextBlock Style="{StaticResource Hint}" Text="z. B. https://gitea.firma.local"/>

        <TextBlock Style="{StaticResource Label}" Text="Benutzername"/>
        <TextBox x:Name="UsernameBox"/>

        <TextBlock Style="{StaticResource Label}" Text="Access-Token"/>
        <PasswordBox x:Name="TokenBox"/>
        <TextBlock x:Name="TokenHint" Style="{StaticResource Hint}"/>
        <TextBlock Style="{StaticResource Hint}">
            <Hyperlink x:Name="TokenLink" Foreground="#7DA2DC" Click="OnTokenLinkClick">Token in Gitea erstellen</Hyperlink>
            <Run Text=" – Berechtigung „user: Lesen“ genügt."/>
        </TextBlock>

        <TextBlock Style="{StaticResource Label}" Text="Aktualisieren alle (Minuten)"/>
        <TextBox x:Name="RefreshBox" Width="80" HorizontalAlignment="Left"/>

        <CheckBox x:Name="AutostartBox" Content="Mit Windows starten"/>
        <CheckBox x:Name="AutoUpdateBox" Content="Updates automatisch installieren"/>
        <CheckBox x:Name="IgnoreCertBox" Content="Zertifikatsfehler ignorieren (nur interne CA)"/>

        <Border x:Name="ResultBorder" Margin="0,14,0,0" Padding="8,6" CornerRadius="4" Background="#2D2E31" Visibility="Collapsed">
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="TestButton" DockPanel.Dock="Left" Content="Verbindung testen" Click="OnTestClick"/>
            <Button DockPanel.Dock="Right" Content="Abbrechen" IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Speichern" IsDefault="True" Click="OnSaveClick"/>
        </DockPanel>
        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
